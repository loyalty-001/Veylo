{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veylo-operations",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
  "vars": {
    "ACCESS_AUD": "389f8e0434ec94f8093a267fac71ba9d77ec4f354e2b7c4722f0f52ce4b4f533",
    "ADMIN_READY": "true",
    "OWNER_EMAIL": "goodlucknosakhare9@gmail.com",
    "ADMIN_ORIGIN": "https://veylo-operations.scrde.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veylo-operations",
      "database_id": "b85d6373-0e68-4816-86ff-04cf67bbfb20",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "INGEST_LIMITER",
      "namespace_id": "2026102501",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html*", "**/*.css*", "**/*.txt*", "**/*.svg*"],
      "fallthrough": true,
    },
  ],
}
