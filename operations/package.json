{
  "dependencies": {
    "hono": "4.13.14",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261025.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.152.0"
  },
  "name": "veylo-operations",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit && node --check --input-type=module < src/ui/app.js.txt",
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2022 --minify --loader:.html=text --loader:.css=text --loader:.txt=text --loader:.svg=text --outfile=.build/worker.mjs",
    "types": "wrangler types --strict-vars=false"
  }
}
